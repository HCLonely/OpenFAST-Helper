{
  "comments": {
    "lineComment": "!"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "[A-Za-z][A-Za-z0-9_]*(?:\\([0-9]+\\))?",
  "folding": {
    "markers": {
      "start": "^\\s*[-=]{3,}.*(?:CONTROL|CONDITIONS|OPTIONS|PARAMETERS|OUTPUT|MEMBERS|WAVES|COEFFICIENTS|PROPERTIES|POINTS|LINES)",
      "end": "^END\\b"
    }
  }
}
