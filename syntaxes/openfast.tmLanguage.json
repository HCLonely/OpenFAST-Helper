{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OpenFAST",
  "scopeName": "source.openfast",
  "patterns": [
    {
      "begin": "^\\s*(?:((?:BldNd_)?OutList)\\b.*|((?!.*\\bNODE\\b)[-=!\\s]+.*OUTPUT(?: CHANNELS|S).*))$",
      "end": "(?=^\\s*[\"\\x27]?END\\b|^\\s*[-=]{3})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.outlist.openfast"
        },
        "2": {
          "name": "markup.heading.openfast"
        }
      },
      "patterns": [
        {
          "match": "!.*$|\\s[-\u2013]\\s.*$",
          "name": "comment.line.description.openfast"
        },
        {
          "match": "\\b[A-Za-z][A-Za-z0-9_]*\\b",
          "name": "support.constant.output.openfast"
        }
      ]
    },
    {
      "match": "^\\s*(?:[-=]{3,}.*|![-=]{3,}.*)$",
      "name": "markup.heading.openfast"
    },
    {
      "match": "^\\s*END\\b.*$",
      "name": "keyword.control.end.openfast"
    },
    {
      "match": "^(\\s*)([-+.]|[-+]?\\d+(?:\\.\\d*)?[eEdD][-+]?)(\\s+)([A-Za-z]\\w*(?:\\(\\d+\\))?)(\\s+[-\u2013]\\s.*)$",
      "captures": {
        "2": {
          "name": "constant.numeric.openfast"
        },
        "4": {
          "name": "variable.parameter.openfast"
        },
        "5": {
          "name": "comment.line.description.openfast"
        }
      }
    },
    {
      "match": "^(\\s*(?:\"[^\"\\r\\n]*\"|'[^'\\r\\n]*'|[-+]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[EeDd][-+]?[0-9]+)?|(?i:true|false|default|mcf|ranlux|none|unused|fixed|vessel|n/a)|[^\\s\"']*[\\\\/][^\\s\"']*)(?:[\\s,]+(?:\"[^\"\\r\\n]*\"|'[^'\\r\\n]*'|[-+]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[EeDd][-+]?[0-9]+)?|(?i:true|false|default|mcf|ranlux|none|unused|fixed|vessel|n/a)|[^\\s\"']*[\\\\/][^\\s\"']*))*)(\\s*!\\s*)([A-Za-z][A-Za-z0-9_]*(?:\\([0-9]+\\))?)(\\s*-\\s*.*)$",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#values"
            }
          ]
        },
        "2": {
          "name": "punctuation.definition.comment.openfast"
        },
        "3": {
          "name": "variable.parameter.openfast"
        },
        "4": {
          "name": "comment.line.description.openfast"
        }
      }
    },
    {
      "match": "^(\\s*(?:\"[^\"\\r\\n]*\"|'[^'\\r\\n]*'|[-+]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[EeDd][-+]?[0-9]+)?|(?i:true|false|default|mcf|ranlux|none|unused|fixed|vessel|n/a)|[^\\s\"']*[\\\\/][^\\s\"']*)(?:[\\s,]+(?:\"[^\"\\r\\n]*\"|'[^'\\r\\n]*'|[-+]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[EeDd][-+]?[0-9]+)?|(?i:true|false|default|mcf|ranlux|none|unused|fixed|vessel|n/a)|[^\\s\"']*[\\\\/][^\\s\"']*))*)(\\s+)([A-Za-z][A-Za-z0-9_]*(?:\\([0-9]+\\))?)(\\s*[-\u2013]\\s.*|\\s*!.*|\\s*)$",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#values"
            }
          ]
        },
        "3": {
          "name": "variable.parameter.openfast"
        },
        "4": {
          "name": "comment.line.description.openfast"
        }
      }
    },
    {
      "match": "!.*$",
      "name": "comment.line.exclamation.openfast"
    },
    {
      "include": "#values"
    },
    {
      "match": "\\s[-\u2013]\\s.*$",
      "name": "comment.line.description.openfast"
    }
  ],
  "repository": {
    "values": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.openfast"
        },
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.openfast"
        },
        {
          "match": "(?i)\\b(?:true|false|default|mcf|ranlux|none|unused|fixed|vessel|n/a)\\b",
          "name": "constant.language.openfast"
        },
        {
          "match": "(?<![A-Za-z0-9_])[-+]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[EeDd][-+]?[0-9]+)?(?![A-Za-z0-9_])",
          "name": "constant.numeric.openfast"
        }
      ]
    }
  }
}
